# Execution begins at address 0 
    .pos 0
    irmovq stack, %rsp  	# Set up stack pointer
    call main		# Execute main program
    halt			# Terminate program

.align 8
Array:
    .quad 0xbca
    .quad 0xcba
    .quad 0xacb
    .quad 0xcab
    .quad 0xabc
    .quad 0xbac

main:
    irmovq Array, %rdi
    irmovq $6, %rsi
    irmovq $8, %r11
    call bubble_sort
    ret


bubble_sort:
    rrmovq %rsi, %r14
    addq %r14, %r14
    addq %r14, %r14
    addq %r14, %r14
    rrmovq %r14, %rdx
    addq %rdi, %rdx
    jmp loop1

loop1:
    rrmovq %rdx, %r13
    subq %rdi, %r13
    jle ans
    jmp loop2
    

loop2:
    subq %r11, %rdx
    rrmovq %rdi, %rbx
    jmp loop3

loop3:
    rrmovq %rbx, %r13
    subq %rdx, %r13
    je loop1
    jmp loop4

loop4:
    rrmovq %r11, %r8
    addq %rbx, %r8
    mrmovq (%r8), %r13
    mrmovq (%rbx), %r12
    subq %r12, %r13
    jl swap
    rrmovq %r8, %rbx
    jmp loop3


swap:
    mrmovq (%r8), %r9
    mrmovq (%rbx), %r10
    rmmovq %r9, (%rbx)
    rmmovq %r10, (%r8)

    rrmovq %r8, %rbx
    jmp loop3


ans:
    ret

# The stack starts here and grows to lower addresses
	.pos 0x200		
stack:	

