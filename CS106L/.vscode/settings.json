{
    // 这里的设置只有当你用 VS Code 直接打开 CS106L 文件夹时才会生效
    "github.copilot.enable": {
        "cpp": false
    },
    "[cpp]": {
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": false
        },
        "editor.inlineSuggest.enabled": false
    },
    "C_Cpp.default.compilerPath": "/usr/bin/g++-13",
    "cmake.ignoreCMakeListsMissing": true
}